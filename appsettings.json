{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "NCFConnection": "Server=AAHR001;Database=NCFDonorDb;Integrated Security=True;TrustServerCertificate=True;"
  },

  "JwtSettings": {
    "SecretKey": "a-very-long-secret-key-32bytes-minimum",
    "Issuer": "NCFApi",
    "Audience": "NCFUsers",
    "ExpirationMinutes": 60
  },

  "RoleSettings": {
    "DefaultRole": "Viewer",
    "AdminRole": "Admin",
    "ManagerRole": "Manager"
  },

  "CorsPolicy": {
    "AllowedOrigins": [ "https://example.com", "http://localhost:3000" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE" ]
  },

  "AzureFunctionSettings": {
    "Worker:HostEndpoint": "http://localhost:7071",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true"
  }
}